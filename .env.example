# PostgreSQL / Supabase Connection Strings (Prisma ORM)
# Na Vercel (serverless), use a URL com PgBouncer (porta 6543 + ?pgbouncer=true) em DATABASE_URL
DATABASE_URL="postgresql://postgres:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Conexão direta (porta 5432) usada pelo Prisma CLI para migrations (`npx prisma migrate deploy`)
DIRECT_URL="postgresql://postgres:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

# Autenticação JWT (OBRIGATÓRIO em produção na Vercel — gere uma chave aleatória forte de 32+ bytes)
JWT_SECRET="substitua-por-uma-chave-secreta-forte-em-producao"

# Supabase Storage opcional para upload persistente de avatares e banners (bucket público: profiles)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Recuperação de senha por e-mail gratuito (Brevo HTTP API v3 — 300 e-mails/dia grátis)
# Se ausente em desenvolvimento/testes, os links são capturados localmente em log/memória.
BREVO_API_KEY=""
MAIL_FROM="YuukiList <no-reply@yuukilist.app>"
APP_URL="http://localhost:3000"

# Ambiente de execução
NODE_ENV=development
