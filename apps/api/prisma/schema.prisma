datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Category {
  DORAMA
  FILME
  ANIME
  MANGA
  MANHWA
  MANHUA
}

enum PublicationStatus {
  EM_ANDAMENTO
  FINALIZADA
  CANCELADA
  HIATO
  DESCONHECIDA
}

model MediaItem {
  id                String            @id @default(uuid()) @db.Uuid
  slug              String            @unique @db.VarChar(160)
  title             String            @db.VarChar(255)
  originalTitle     String?           @map("original_title") @db.VarChar(255)
  romanizedTitle    String?           @map("romanized_title") @db.VarChar(255)
  normalizedTitle   String            @map("normalized_title") @db.VarChar(255)
  synopsis          String            @db.Text
  category          Category
  publicationStatus PublicationStatus @map("publication_status")
  releaseYear       Int?              @map("release_year")
  originCountry     String            @map("origin_country") @db.VarChar(64)
  rating            Float?
  coverPath         String            @map("cover_path") @db.VarChar(255)
  totalEpisodes     Int?              @map("total_episodes")
  totalChapters     Int?              @map("total_chapters")
  totalVolumes      Int?              @map("total_volumes")
  provenance        Json?             @map("provenance")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  genres            ItemGenre[]
  aliases           ItemAlias[]
  libraryItems      UserLibraryItem[]

  @@index([category, publicationStatus])
  @@index([normalizedTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "media_items_normalized_title_trgm_idx")
  @@map("media_items")
}

model ItemGenre {
  id          String    @id @default(uuid()) @db.Uuid
  mediaItemId String    @map("media_item_id") @db.Uuid
  name        String    @db.VarChar(80)
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([mediaItemId, name])
  @@index([name])
  @@map("item_genres")
}

model ItemAlias {
  id              String    @id @default(uuid()) @db.Uuid
  mediaItemId     String    @map("media_item_id") @db.Uuid
  alias           String    @db.VarChar(255)
  normalizedAlias String    @map("normalized_alias") @db.VarChar(255)
  languageCode    String    @map("language_code") @db.VarChar(16)
  mediaItem       MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@index([mediaItemId])
  @@map("item_aliases")
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique @db.VarChar(255)
  normalizedEmail    String   @unique @map("normalized_email") @db.VarChar(255)
  username           String   @unique @db.VarChar(64)
  normalizedUsername String   @unique @map("normalized_username") @db.VarChar(64)
  passwordHash       String   @map("password_hash") @db.VarChar(255)
  avatarUrl          String?  @map("avatar_url") @db.VarChar(512)
  avatarFrame        String?  @default("none") @map("avatar_frame") @db.VarChar(32)
  bannerUrl          String?  @map("banner_url") @db.VarChar(512)
  bio                String?  @db.VarChar(500)
  phone              String?  @db.VarChar(32)
  location           String?  @db.VarChar(120)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  libraryItems       UserLibraryItem[]

  @@index([normalizedEmail])
  @@index([normalizedUsername])
  @@map("users")
}

model UserLibraryItem {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  mediaItemId  String    @map("media_item_id") @db.Uuid
  status       String    @db.VarChar(32)
  progress     Int       @default(0)
  rating       Float?
  notes        String?   @db.Text
  isFavorite   Boolean   @default(false) @map("is_favorite")
  rewatchCount Int       @default(0) @map("rewatch_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItem    MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaItemId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("user_library_items")
}


