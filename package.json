{
  "name": "yuukilist-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "YuukiList — Plataforma de acompanhamento e catálogo de entretenimento asiático",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "lint": "npm run --workspaces --if-present lint",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}

